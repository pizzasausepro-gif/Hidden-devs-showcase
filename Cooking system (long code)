-- ─────────────────────────────────────────────
-- HELPERS
-- ─────────────────────────────────────────────

local function getModelFolder(category)
	if category == "Base"     then return models:FindFirstChild("Bases")     end
	if category == "Flavor"   then return models:FindFirstChild("Flavours")  end
	if category == "Modifier" then return models:FindFirstChild("Modifiers") end
end

local function countSelected()
	local n = 0
	for _, v in pairs(selectedSlots) do if v then n += 1 end end
	return n
end

local function getInventoryItemsForCategory(category)
	local seen, items = {}, {}
	for _, v in ipairs(inventoryFolder:GetChildren()) do
		if v:IsA("StringValue") and not seen[v.Value] then
			local data = IngredientIndex[v.Value]
			if data and data.Type == category then
				seen[v.Value] = true
				table.insert(items, v.Value)
			end
		end
	end
	return items
end

local function hasAtLeastOneIngredient()
	for _, v in ipairs(inventoryFolder:GetChildren()) do
		if v:IsA("StringValue") then
			local data = IngredientIndex[v.Value]
			if data and (data.Type == "Base" or data.Type == "Flavor" or data.Type == "Modifier") then
				return true
			end
		end
	end
	return false
end

-- ─────────────────────────────────────────────
-- WATER COLOR
-- ─────────────────────────────────────────────

local function rebuildWaterColor()
	local colors = {}
	for _, ingredient in pairs(selectedSlots) do
		if ingredient then
			local col = IngredientIndex[ingredient].Color
			if col then
				local parts = string.split(col, ",")
				table.insert(colors, {
					tonumber(parts[1]) or 255,
					tonumber(parts[2]) or 255,
					tonumber(parts[3]) or 255,
				})
			end
		end
	end
	local target
	if #colors == 0 then
		target = originalWaterColor
	else
		local r, g, b = 0, 0, 0
		for _, c in ipairs(colors) do r += c[1]; g += c[2]; b += c[3] end
		target = Color3.fromRGB(r / #colors, g / #colors, b / #colors)
	end
	TweenService:Create(water, TWEEN_COLOR, {Color = target}):Play()
end

local function resetWaterColor()
	TweenService:Create(water, TWEEN_COLOR, {Color = originalWaterColor}):Play()
end

-- ─────────────────────────────────────────────
-- VIEWPORT
-- ─────────────────────────────────────────────

local function clearRotConnections()
	for _, conn in ipairs(rotConnections) do conn:Disconnect() end
	rotConnections = {}
end

local function createViewport(parent, itemName, category)
	for _, c in ipairs(parent:GetChildren()) do
		if c:IsA("ViewportFrame") or c:IsA("TextLabel") then c:Destroy() end
	end

	local vp = Instance.new("ViewportFrame")
	vp.Size               = UDim2.new(1, -8, 1, -22)
	vp.Position           = UDim2.new(0, 4, 0, 4)
	vp.BackgroundTransparency = 1
	vp.Parent             = parent

	local cam = Instance.new("Camera")
	cam.Parent       = vp
	vp.CurrentCamera = cam

	local folder = getModelFolder(category)
	if not folder then return end
	local source = folder:FindFirstChild(itemName)
	if not source then return end

	local model = source:Clone()
	model.Parent = vp

	local cf, size = model:GetBoundingBox()
	local maxSize  = math.max(size.X, size.Y, size.Z)
	local dist     = maxSize / (2 * math.tan(math.rad(20))) * 1.35
	local angle    = 0

	local conn = RunService.RenderStepped:Connect(function(dt)
		if not vp.Parent then return end
		angle += dt * 35
		local rad = math.rad(angle)
		cam.CFrame = CFrame.new(
			cf.Position + Vector3.new(math.sin(rad) * dist, maxSize * 0.1, math.cos(rad) * dist),
			cf.Position
		)
	end)
	table.insert(rotConnections, conn)

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size                   = UDim2.new(1, 0, 0, 14)
	nameLabel.Position               = UDim2.new(0, 0, 1, -15)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text                   = IngredientIndex[itemName].DisplayName
	nameLabel.TextScaled             = true
	nameLabel.Font                   = Enum.Font.GothamBold
	nameLabel.TextColor3             = Color3.new(1, 1, 1)
	nameLabel.Parent                 = parent
end

