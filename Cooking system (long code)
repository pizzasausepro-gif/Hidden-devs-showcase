-- ─────────────────────────────────────────────
-- COOK ANIMATION
-- ─────────────────────────────────────────────

local function playCookAnimation(candy)
	if mainFrame then
		TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quint), {
			Position = UDim2.new(0.5, 0, 0, -220)
		}):Play()
	end
	if selectedHolder then
		TweenService:Create(selectedHolder, TweenInfo.new(0.25, Enum.EasingStyle.Quint), {
			Position = UDim2.new(0.5, 0, 1, 120)
		}):Play()
	end

	task.wait(0.3)
	setLid(false)
	playSound("Metal")
	task.wait(0.5)

	local candyTemplate = models:WaitForChild("CandyModel"):Clone()
	candyTemplate.Parent = workspace

	if not candyTemplate.PrimaryPart then
		candyTemplate.PrimaryPart = candyTemplate:FindFirstChildWhichIsA("BasePart")
	end
	if not candyTemplate.PrimaryPart then
		candyTemplate:Destroy()
		return
	end

	for _, p in ipairs(candyTemplate:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored   = true
			p.CanCollide = false
			p.CastShadow = false
			p.Material   = Enum.Material.Neon
			p.Color      = Color3.new(0, 0, 0)
		end
	end
	for _, desc in ipairs(candyTemplate:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then desc.Enabled = false end
	end

	local startCF = dropper.CFrame * CFrame.new(0, -6, 0)
	local endCF   = dropper.CFrame * CFrame.new(0, -1.7, -0.2)
	candyTemplate:PivotTo(startCF)

	local vfxFolder = ReplicatedStorage:WaitForChild("VFX")

	local candyAura = vfxFolder:FindFirstChild("Candy") and vfxFolder.Candy:Clone()
	if candyAura then
		candyAura.Parent = candyTemplate.PrimaryPart
		local flare = candyAura:FindFirstChild("Flare")
		if flare and flare:IsA("ParticleEmitter") then
			flare.Enabled  = true
			flare.Rate     = 5
			flare.RotSpeed = NumberRange.new(5, 5)
		end
	end

	local hl = Instance.new("Highlight")
	hl.FillColor           = Color3.new(0, 0, 0)
	hl.OutlineColor        = Color3.new(1, 1, 1)
	hl.FillTransparency    = 0.1
	hl.OutlineTransparency = 0
	hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent              = candyTemplate

	local startPos     = startCF.Position
	local endPos       = endCF.Position
	local slideStart   = tick()
	local slideDuration = 2

	local slideConn
	slideConn = RunService.RenderStepped:Connect(function(dt)
		if not candyTemplate.Parent then slideConn:Disconnect() return end
		local t    = math.clamp((tick() - slideStart) / slideDuration, 0, 1)
		local ease = 1 - (1 - t) ^ 3
		local pos  = startPos:Lerp(endPos, ease)
		candyTemplate:PivotTo(CFrame.new(pos))
	end)

	playSound("Fill")

	colorCorrection.Enabled = true
	TweenService:Create(colorCorrection, TweenInfo.new(7, Enum.EasingStyle.Sine), {
		Brightness = -0.25,
		Contrast   = 0.8,
		Saturation = -0.5,
	}):Play()
	TweenService:Create(camera, TweenInfo.new(7, Enum.EasingStyle.Sine), {
		FieldOfView = CAMERA_FOV + 12
	}):Play()

	local flareConn
	local animStart    = tick()
	local animDuration = 7

	if candyAura then
		local flare = candyAura:FindFirstChild("Flare")
		if flare and flare:IsA("ParticleEmitter") then
			flareConn = RunService.Heartbeat:Connect(function()
				if not candyTemplate.Parent then flareConn:Disconnect() return end
				local t = math.clamp((tick() - animStart) / animDuration, 0, 1)
				flare.Rate = 5 + (t * 120)
			end)
		end
	end

	local spinConn
	local spinAngle = 0
	spinConn = RunService.RenderStepped:Connect(function(dt)
		if not candyTemplate.Parent then spinConn:Disconnect() return end
		spinAngle += dt * 180
		local pos = candyTemplate:GetPivot().Position
		candyTemplate:PivotTo(CFrame.new(pos) * CFrame.Angles(0, math.rad(spinAngle * dt), 0))
	end)

	local waitStart = tick()
	while not pendingCandy and (tick() - waitStart) < 7 do
		task.wait(0.1)
	end

	if slideConn then slideConn:Disconnect() end
	if spinConn  then spinConn:Disconnect()  end
	if flareConn then flareConn:Disconnect() end

	local candyData = pendingCandy
	pendingCandy = nil

	screenShake(0.4, 0.3)

	-- Use pre-built flash frame
	local flash = cookingGui:WaitForChild("Flash")
	flash.BackgroundTransparency = 1
	flash.Visible = true

	TweenService:Create(flash, TweenInfo.new(0.08), {BackgroundTransparency = 0}):Play()
	playSound("Unlock1")
	task.wait(0.08)

	TweenService:Create(colorCorrection, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {
		Brightness = 0,
		Contrast   = 0,
		Saturation = 0,
	}):Play()
	TweenService:Create(camera, TweenInfo.new(0.6, Enum.EasingStyle.Sine), {
		FieldOfView = CAMERA_FOV
	}):Play()

	if candyData and candyData.CandyColor then
		local r, g, b = candyData.CandyColor:match("(%d+),(%d+),(%d+)")
		if r then
			local col = Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
			for _, p in ipairs(candyTemplate:GetDescendants()) do
				if p:IsA("BasePart") then
					p.Color    = col
					p.Material = Enum.Material.SmoothPlastic
				end
			end
		end
	end

	if candyAura then candyAura:Destroy() end

	local gloryVFX = vfxFolder:FindFirstChild("Glory") and vfxFolder.Glory:Clone()
	if gloryVFX then gloryVFX.Parent = candyTemplate.PrimaryPart end

	hl.FillTransparency    = 0.6
	hl.OutlineTransparency = 0.4

	TweenService:Create(flash, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
	task.wait(0.3)
	flash.Visible = false

	burstVFX(candyTemplate.PrimaryPart, "Smoke", 0.75)

	task.spawn(function()
		local steamVFX = vfxFolder:FindFirstChild("Steam") and vfxFolder.Steam:Clone()
		if steamVFX then steamVFX.Parent = water end
		task.wait(1)
		if steamVFX then steamVFX:Destroy() end
	end)

	if candyData then showRevealUI(candyData) end

	camera.CameraType = Enum.CameraType.Custom

	local char = player.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")

	if hrp then
		local trail = Instance.new("Trail")
		trail.Attachment0 = Instance.new("Attachment", candyTemplate.PrimaryPart)
		trail.Attachment1 = Instance.new("Attachment", candyTemplate.PrimaryPart)
		trail.Attachment1.Position = Vector3.new(0, 0.5, 0)
		trail.Lifetime    = 0.3
		trail.MinLength   = 0
		trail.FaceCamera  = true
		trail.Color       = ColorSequence.new(Color3.new(1, 1, 1))
		trail.Transparency = NumberSequence.new(0, 1)
		trail.Parent      = candyTemplate

		local flyStart  = candyTemplate:GetPivot().Position
		local flyTarget = hrp.Position
		local flyTime   = 0.6
		local flyStartT = tick()

		local flyConn
		flyConn = RunService.RenderStepped:Connect(function()
			if not candyTemplate.Parent then flyConn:Disconnect() return end
			local t         = math.clamp((tick() - flyStartT) / flyTime, 0, 1)
			local ease      = t ^ 2
			local newTarget = hrp and hrp.Position or flyTarget
			local pos       = flyStart:Lerp(newTarget, ease)
			candyTemplate:PivotTo(CFrame.new(pos))
			if t >= 1 then
				flyConn:Disconnect()
				burstVFX(hrp, "Goon", 0.75)
				playSound("Pop")
				candyTemplate:Destroy()
			end
		end)
	else
		candyTemplate:Destroy()
	end

	task.wait(1)
	blur.Enabled            = false
	colorCorrection.Enabled = false
	cookingBusy             = false

	closeCooking()
end

-- ─────────────────────────────────────────────
-- CREATE UI — finds pre-built UI from PlayerGui
-- ─────────────────────────────────────────────

local function createUI()
	cookingGui = player.PlayerGui:WaitForChild("CookingUI")
	cookingGui.Enabled = true

	mainFrame      = cookingGui:WaitForChild("Selector")
	scrollingFrame = mainFrame:WaitForChild("Inventory")
	categoryLabel  = mainFrame:WaitForChild("Category")
	selectedHolder = cookingGui:WaitForChild("Selected")
	cookButton     = mainFrame:WaitForChild("Controls"):WaitForChild("Cook")

	-- Reset positions to parked
	mainFrame.Position      = UDim2.new(0.5, 0, 0, -220)
	selectedHolder.Position = UDim2.new(0.5, 0, 1, 120)

	-- Reset flash and reveal labels
	local flash = cookingGui:WaitForChild("Flash")
	flash.Visible = false

	local nameReveal  = cookingGui:WaitForChild("NameReveal")
	local statsReveal = cookingGui:WaitForChild("StatsReveal")
	nameReveal.Visible  = false
	statsReveal.Visible = false

	-- Wire close button
	local closeBtn = mainFrame:WaitForChild("CloseBtn")
	closeBtn.MouseButton1Click:Connect(function()
		if cookingBusy then return end
		playSound("Click")
		closeCooking()
	end)

	-- Wire cook button
	cookButton.MouseButton1Click:Connect(function()
		if cookingBusy then return end
		local n = countSelected()
		if n < 1 then
			playSound("Error")
			NotificationModule.Notify("Need at least 1 ingredient!")
			return
		end
		cookingBusy = true
		playSound("Fill")
		local list = {}
		if selectedSlots.Base     then table.insert(list, selectedSlots.Base)     end
		if selectedSlots.Flavor   then table.insert(list, selectedSlots.Flavor)   end
		if selectedSlots.Modifier then table.insert(list, selectedSlots.Modifier) end
		remotes.CookingEvent:FireServer(list)
		task.spawn(playCookAnimation)
	end)

	-- Slide in
	TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, 18)
	}):Play()
	TweenService:Create(selectedHolder, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 1, -28)
	}):Play()

	refreshInventory()
	refreshSelectedSlots()
	updateCookButton()
end

-- ─────────────────────────────────────────────
-- OPEN
-- ─────────────────────────────────────────────

local function openCooking()
	if opened then return end
	if not hasAtLeastOneIngredient() then
		NotificationModule.Notify("Need at least 1 ingredient to cook!")
		playSound("Error")
		return
	end
	opened = true
	prompt.Enabled = false
	playSound("Click")
	hideOtherGuis()
	freezeCharacter(true)
	setLid(true)
	moveCamera()
	createUI()
end

-- ─────────────────────────────────────────────
-- PROMPT
-- ─────────────────────────────────────────────

prompt.Triggered:Connect(function(plr)
	if plr ~= player then return end
	openCooking()
end)

-- ─────────────────────────────────────────────
-- COOKING COMPLETE
-- ─────────────────────────────────────────────

remotes.CookingComplete.OnClientEvent:Connect(function(candy, err)
	if err then
		playSound("Error")
		NotificationModule.Notify(err)
		cookingBusy = false
		return
	end
	if candy then
		pendingCandy = candy
		NotificationModule.Notify("Created: " .. candy.DisplayName)
	end
end)
