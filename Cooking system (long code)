local function hideOtherGuis()
	hiddenGuis = {}
	for _, g in ipairs(player.PlayerGui:GetChildren()) do
		if g:IsA("ScreenGui") and g.Enabled and g.Name ~= "CookingUI" then
			table.insert(hiddenGuis, g)
			g.Enabled = false
		end
	end
end

local function restoreOtherGuis()
	for _, g in ipairs(hiddenGuis) do
		if g and g.Parent then g.Enabled = true end
	end
	hiddenGuis = {}
end

-- ─────────────────────────────────────────────
-- CAMERA
-- ─────────────────────────────────────────────

local function moveCamera()
	originalCameraType   = camera.CameraType
	originalCameraCFrame = camera.CFrame
	originalFOV          = camera.FieldOfView
	camera.CameraType    = Enum.CameraType.Scriptable
	local targetPos = dropper.Position + (dropper.CFrame.LookVector * 6) + Vector3.new(0, 2.2, 0)
	local lookPos   = dropper.Position + Vector3.new(0, -5, 0)
	local targetCF  = CFrame.new(targetPos, lookPos)
	local value = Instance.new("CFrameValue")
	value.Value = camera.CFrame
	value:GetPropertyChangedSignal("Value"):Connect(function()
		camera.CFrame = value.Value
	end)
	local tween = TweenService:Create(value,
		TweenInfo.new(CAMERA_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{Value = targetCF}
	)
	tween:Play()
	TweenService:Create(camera, TweenInfo.new(CAMERA_TIME), {FieldOfView = CAMERA_FOV}):Play()
	tween.Completed:Wait()
	value:Destroy()
end

local function restoreCamera()
	if not originalCameraCFrame then return end
	TweenService:Create(camera, TweenInfo.new(1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		CFrame      = originalCameraCFrame,
		FieldOfView = originalFOV,
	}):Play()
	task.wait(1)
	camera.CameraType    = originalCameraType
	originalCameraCFrame = nil
end

