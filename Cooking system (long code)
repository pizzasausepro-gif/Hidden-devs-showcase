local function updateCookButton()
	if not cookButton then return end
	local n = countSelected()
	local texts = {"COOK (0/1)", "COOK (1/3) ✓", "COOK (2/3) ✓", "COOK (3/3) ✓"}
	cookButton.Text = texts[n + 1] or "COOK (3/3) ✓"
	local ready = n >= 1
	TweenService:Create(cookButton, TWEEN_FAST, {
		BackgroundColor3 = ready and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40),
		TextColor3       = ready and Color3.fromRGB(0, 0, 0)       or Color3.fromRGB(180, 180, 180),
	}):Play()
end

-- ─────────────────────────────────────────────
-- SELECTED SLOTS
-- ─────────────────────────────────────────────

local function refreshSelectedSlots()
	if not selectedHolder then return end
	local order = {selectedSlots.Base, selectedSlots.Flavor, selectedSlots.Modifier}
	local types  = {"Base", "Flavor", "Modifier"}
	local index  = 1

	for _, slot in ipairs(selectedHolder:GetChildren()) do
		if not slot:IsA("Frame") then continue end

		local ingredient = order[index]
		local typeName   = types[index]

		for _, c in ipairs(slot:GetChildren()) do
			if c:IsA("ViewportFrame") or c:IsA("TextLabel") or c:IsA("TextButton") then c:Destroy() end
		end

		local stroke = slot:FindFirstChildOfClass("UIStroke")
		if stroke then
			local isActive = (index == currentStep)
			TweenService:Create(stroke, TWEEN_FAST, {
				Color        = isActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(80, 80, 80),
				Transparency = isActive and 0 or 0.6,
			}):Play()
		end

		local plus = slot:FindFirstChild("Plus")
		if not plus then
			plus = Instance.new("TextLabel")
			plus.Name               = "Plus"
			plus.Size               = UDim2.new(1, 0, 1, 0)
			plus.BackgroundTransparency = 1
			plus.Text               = "+"
			plus.TextColor3         = Color3.fromRGB(80, 80, 80)
			plus.TextSize           = 28
			plus.Font               = Enum.Font.GothamMedium
			plus.Parent             = slot
		end
		plus.Visible = ingredient == nil

		if ingredient then createViewport(slot, ingredient, typeName) end

		local btn = Instance.new("TextButton")
		btn.Size               = UDim2.new(1, 0, 1, 0)
		btn.BackgroundTransparency = 1
		btn.Text               = ""
		btn.ZIndex             = 5
		btn.Parent             = slot

		local capturedIndex = index
		btn.MouseButton1Click:Connect(function()
			playSound("Click")
			currentStep = capturedIndex
			refreshInventory()
			refreshSelectedSlots()
		end)

		index += 1
	end
end

-- ─────────────────────────────────────────────
-- INVENTORY
-- ─────────────────────────────────────────────

function refreshInventory()
	if not scrollingFrame then return end

	-- Clear all frames except CardTemplate and NoneCard templates
	for _, v in ipairs(scrollingFrame:GetChildren()) do
		if v:IsA("Frame") and v.Name ~= "CardTemplate" and v.Name ~= "NoneCard" then
			v:Destroy()
		end
	end

	local category = CATEGORY_ORDER[currentStep]
	if categoryLabel then categoryLabel.Text = DISPLAY_NAMES[category] end

	local items = getInventoryItemsForCategory(category)

	-- NONE card — clone from template
	local noneTemplate = scrollingFrame:WaitForChild("NoneCard")
	local noneCard = noneTemplate:Clone()
	noneCard.Name    = "NoneCard_Active"
	noneCard.Visible = true
	noneCard.LayoutOrder = 0
	noneCard.Parent  = scrollingFrame

	local noneStroke = noneCard:FindFirstChildOfClass("UIStroke")
	if noneStroke then
		noneStroke.Transparency = selectedSlots[category] == nil and 0.3 or 0.88
	end

	local noneBtn = noneCard:FindFirstChild("NoneBtn")
	if noneBtn then
		noneBtn.MouseEnter:Connect(function()
			TweenService:Create(noneCard, TWEEN_FAST, {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}):Play()
		end)
		noneBtn.MouseLeave:Connect(function()
			TweenService:Create(noneCard, TWEEN_FAST, {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}):Play()
		end)
		noneBtn.MouseButton1Click:Connect(function()
			playSound("Click")
			selectedSlots[category] = nil
			rebuildWaterColor()
			if currentStep < #CATEGORY_ORDER then
				currentStep += 1
				refreshInventory()
			end
			refreshSelectedSlots()
			updateCookButton()
		end)
	end

	-- Ingredient cards — clone from CardTemplate
	local cardTemplate = scrollingFrame:WaitForChild("CardTemplate")

	for i, itemName in ipairs(items) do
		local card = cardTemplate:Clone()
		card.Name        = itemName
		card.Visible     = true
		card.LayoutOrder = i
		card.Parent      = scrollingFrame

		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = (selectedSlots[category] == itemName) and 0 or 0.88
		end

		-- Clear template VP and rebuild with actual model
		local vp = card:FindFirstChild("VP")
		if vp then vp:Destroy() end
		local itemNameLabel = card:FindFirstChild("ItemName")
		if itemNameLabel then itemNameLabel:Destroy() end

		createViewport(card, itemName, category)

		local btn = card:FindFirstChild("Btn")
		if btn then
			btn.MouseEnter:Connect(function()
				TweenService:Create(card, TWEEN_FAST, {BackgroundColor3 = Color3.fromRGB(45, 45, 45)}):Play()
				if stroke then TweenService:Create(stroke, TWEEN_FAST, {Transparency = 0.4}):Play() end
			end)
			btn.MouseLeave:Connect(function()
				TweenService:Create(card, TWEEN_FAST, {BackgroundColor3 = Color3.fromRGB(25, 25, 25)}):Play()
				if stroke then
					TweenService:Create(stroke, TWEEN_FAST, {
						Transparency = (selectedSlots[category] == itemName) and 0 or 0.88
					}):Play()
				end
			end)
			btn.MouseButton1Click:Connect(function()
				if selectedSlots[category] == itemName then
					playSound("Click")
					selectedSlots[category] = nil
					rebuildWaterColor()
					refreshInventory()
					refreshSelectedSlots()
					updateCookButton()
					return
				end
				playSound("Pop")
				selectedSlots[category] = itemName
				rebuildWaterColor()
				refreshSelectedSlots()
				updateCookButton()
				if currentStep < #CATEGORY_ORDER then
					currentStep += 1
					refreshInventory()
				else
					refreshInventory()
				end
			end)
		end
	end

	-- Update canvas size (exclude templates from count)
	local visibleCount = #items + 1 -- +1 for none card
	scrollingFrame.CanvasSize = UDim2.new(0, visibleCount * 80, 0, 0)
end

-- ─────────────────────────────────────────────
-- LID
-- ─────────────────────────────────────────────

local function setLid(state)
	local lid = instrument:FindFirstChild("Lid")
	if not lid then return end
	playSound("Metal")
	local startCF  = lid:GetPivot()
	local targetCF = state
		and CFrame.new(startCF.Position) * CFrame.Angles(math.rad(-0.814), math.rad(-180), math.rad(-180))
		or  CFrame.new(startCF.Position) * CFrame.Angles(math.rad(0.814), 0, 0)
	local duration  = 0.35
	local startTime = tick()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t    = math.clamp((tick() - startTime) / duration, 0, 1)
		local ease = 1 - (1 - t) ^ 3
		lid:PivotTo(startCF:Lerp(targetCF, ease))
		if t >= 1 then conn:Disconnect() end
	end)
end

local function burstVFX(parent, attachmentName, duration)
	local vfxFolder = ReplicatedStorage:FindFirstChild("VFX")
	if not vfxFolder then return end
	local source = vfxFolder:FindFirstChild(attachmentName)
	if not source then return end
	local clone = source:Clone()
	clone.Parent = parent
	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = true
			desc:Emit(desc.Rate > 0 and math.ceil(desc.Rate * duration) or 20)
		end
	end
	if clone:IsA("ParticleEmitter") then
		clone.Enabled = true
		clone:Emit(20)
	end
	task.delay(duration, function()
		for _, desc in ipairs(clone:GetDescendants()) do
			if desc:IsA("ParticleEmitter") then desc.Enabled = false end
		end
		if clone:IsA("ParticleEmitter") then clone.Enabled = false end
		task.wait(2)
		if clone.Parent then clone:Destroy() end
	end)
end

