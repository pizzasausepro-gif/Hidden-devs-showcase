-- ─────────────────────────────────────────────
-- ARROW
-- ─────────────────────────────────────────────

local arrowFloatConn = nil
local arrowDriftConn = nil

local function stopArrowAnims()
	if arrowFloatConn then arrowFloatConn:Disconnect(); arrowFloatConn = nil end
	if arrowDriftConn then arrowDriftConn:Disconnect(); arrowDriftConn = nil end
end

local function startArrowFloat(basePos)
	stopArrowAnims()
	Arrow.Visible  = true
	Arrow.Position = basePos
	local t = 0
	arrowFloatConn = RunService.Heartbeat:Connect(function(dt)
		t += dt
		local offset = math.sin(t * 2.5) * 0.008
		Arrow.Position = UDim2.new(
			basePos.X.Scale, basePos.X.Offset,
			basePos.Y.Scale + offset, basePos.Y.Offset
		)
	end)
	print("[Tutorial] Arrow float at", basePos)
end

local function startArrowDrift(basePos)
	stopArrowAnims()
	Arrow.Visible  = true
	Arrow.Position = basePos
	local t = 0
	arrowDriftConn = RunService.Heartbeat:Connect(function(dt)
		t += dt
		local offset = math.sin(t * 2.5) * 0.008
		Arrow.Position = UDim2.new(
			basePos.X.Scale + offset, basePos.X.Offset,
			basePos.Y.Scale, basePos.Y.Offset
		)
	end)
	print("[Tutorial] Arrow drift at", basePos)
end

local function hideArrow()
	stopArrowAnims()
	Arrow.Visible  = false
	Arrow.Rotation = 0
	print("[Tutorial] Arrow hidden")
end

local function showArrow(pos, rotation, drift)
	Arrow.Rotation = rotation or 0
	if drift then
		startArrowDrift(pos)
	else
		startArrowFloat(pos)
	end
end

-- ─────────────────────────────────────────────
-- BEAM
-- ─────────────────────────────────────────────

local activeBeam = nil
local beamAtt0   = nil
local beamAtt1   = nil

local function createBeam(targetPart)
	if activeBeam then activeBeam:Destroy(); activeBeam = nil end
	if beamAtt0   then beamAtt0:Destroy();   beamAtt0 = nil end
	if beamAtt1   then beamAtt1:Destroy();   beamAtt1 = nil end
	if not hrp or not targetPart then warn("[Tutorial] createBeam: nil ref"); return end

	beamAtt0 = Instance.new("Attachment"); beamAtt0.Name = "TutBeamAtt0"; beamAtt0.Parent = hrp
	beamAtt1 = Instance.new("Attachment"); beamAtt1.Name = "TutBeamAtt1"; beamAtt1.Parent = targetPart

	local beam = Instance.new("Beam")
	beam.Attachment0   = beamAtt0
	beam.Attachment1   = beamAtt1
	beam.Width0        = 1.5
	beam.Width1        = 1.5
	beam.Transparency  = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 0.6),
	})
	beam.Color         = ColorSequence.new(Color3.fromRGB(80, 255, 80))
	beam.LightEmission = 0.5
	beam.FaceCamera    = true
	beam.Segments      = 10
	beam.Parent        = hrp
	activeBeam         = beam
	print("[Tutorial] Beam → ", targetPart:GetFullName())
end

local function removeBeam()
	if activeBeam then activeBeam:Destroy(); activeBeam = nil end
	if beamAtt0   then beamAtt0:Destroy();   beamAtt0 = nil end
	if beamAtt1   then beamAtt1:Destroy();   beamAtt1 = nil end
	print("[Tutorial] Beam removed")
end

-- ─────────────────────────────────────────────
-- PROXIMITY
-- ─────────────────────────────────────────────

local function waitUntilClose(targetPart, radius)
	print("[Tutorial] Waiting within", radius, "studs of", targetPart:GetFullName())
	while true do
		task.wait(0.5)
		if hrp and hrp.Parent then
			local dist = (hrp.Position - targetPart.Position).Magnitude
			if dist <= radius then print("[Tutorial] Reached", targetPart.Name); break end
		end
	end
end

