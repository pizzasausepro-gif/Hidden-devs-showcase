-- ─────────────────────────────────────────────

step18_sellCandy = function()
	print("[Tutorial] === STEP 18: Sell Candy ===")
	NotifModule.NotifyTutorial("💰 Sell your candy!")

	local sold    = false
	local SellUI  = PlayerGui:FindFirstChild("SellUI")
	local honorVal = dataFolder:FindFirstChild("Honor")

	-- Primary: SellUI closes after selling
	if SellUI then
		local conn = SellUI:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not SellUI.Enabled then sold = true; print("[Tutorial] SellUI closed — sold!") end
		end)
		-- Secondary: honor increases
		local hConn = nil
		if honorVal then
			local startH = honorVal.Value
			hConn = honorVal:GetPropertyChangedSignal("Value"):Connect(function()
				if honorVal.Value > startH then sold = true; print("[Tutorial] Honor increased — sold!") end
			end)
		end
		while not sold do task.wait(0.2) end
		conn:Disconnect()
		if hConn then hConn:Disconnect() end
	else
		warn("[Tutorial] No SellUI — 10s fallback")
		task.wait(10)
	end

	task.wait(1)
	completeTutorial()
end

